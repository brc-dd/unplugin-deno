{
  "name": "unplugin-deno-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -F unplugin-deno build",
    "test": "pnpm -F unplugin-deno test",
    "test:deno": "pnpm -F unplugin-deno test:deno",
    "test:bun": "pnpm -F unplugin-deno test:bun",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "pnpm -F unplugin-deno typecheck",
    "jsr:dry-run": "pnpm -F unplugin-deno jsr:dry-run",
    "examples:check": "pnpm build && pnpm -r --filter \"./examples/*\" run check",
    "bench": "pnpm build && pnpm -F bench run bench",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm sync-version && pnpm install --lockfile-only",
    "sync-version": "pnpm -F unplugin-deno sync-version",
    "check-version": "pnpm -F unplugin-deno check-version",
    "release": "pnpm build && changeset publish && pnpm -F unplugin-deno jsr:publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0"
  },
  "packageManager": "pnpm@12.5.1"
}
