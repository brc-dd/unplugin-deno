{
  "name": "denoland/import_map",
  "details": "Cases adapted from the Rust tests of https://github.com/denoland/import_map (MIT, see SOURCE.md), in the WPT data-driven format. `expandImports` enables Deno's jsr:/npm: package expansion (ImportMapOptions.expand_imports).",
  "tests": {
    "from_json_2: non-string addresses become null entries": {
      "importMapBaseURL": "https://deno.land",
      "importMap": {
        "imports": {
          "foo": "https://example.com/1",
          "bar": ["https://example.com/2"],
          "fizz": null
        }
      },
      "expectedParsedImportMap": {
        "imports": {
          "foo": "https://example.com/1",
          "bar": null,
          "fizz": null
        },
        "scopes": {}
      }
    },
    "from_json_3: empty addresses, package targets without a trailing slash and empty keys": {
      "importMapBaseURL": "https://deno.land",
      "importMap": {
        "imports": {
          "foo": "https://example.com/1",
          "bar": "",
          "npm/": "https://example.com/2",
          "": "https://example.com/3"
        }
      },
      "expectedParsedImportMap": {
        "imports": {
          "foo": "https://example.com/1",
          "bar": null,
          "npm/": null
        },
        "scopes": {}
      }
    },
    "import_keys: URL-like keys are normalised against the base URL": {
      "importMapBaseURL": "https://deno.land",
      "importMap": {
        "imports": {
          "fs": "https://example.com/1",
          "https://example.com/example/": "https://example.com/2/",
          "/~/": "./lib/"
        }
      },
      "expectedParsedImportMap": {
        "imports": {
          "https://example.com/example/": "https://example.com/2/",
          "https://deno.land/~/": "https://deno.land/lib/",
          "fs": "https://example.com/1"
        },
        "scopes": {}
      }
    },
    "querystring: query strings and fragments after a prefix are kept": {
      "importMapBaseURL": "https://deno.land",
      "baseURL": "https://deno.land",
      "importMap": {
        "imports": {
          "npm/": "https://esm.sh/"
        }
      },
      "expectedResults": {
        "npm/postcss-modules@4.2.2?no-check": "https://esm.sh/postcss-modules@4.2.2?no-check",
        "npm/key/a?b?c": "https://esm.sh/key/a?b?c",
        "npm/postcss-modules@4.2.2?no-check#fragment": "https://esm.sh/postcss-modules@4.2.2?no-check#fragment",
        "npm/postcss-modules@4.2.2#fragment": "https://esm.sh/postcss-modules@4.2.2#fragment"
      }
    },
    "npm_specifiers: opaque npm: prefixes cannot take subpaths, npm:/ prefixes can": {
      "importMapBaseURL": "file:///",
      "baseURL": "file:///main.ts",
      "tests": {
        "npm:aws-sdk/": {
          "importMap": {
            "imports": {
              "aws-sdk/": "npm:aws-sdk/"
            }
          },
          "expectedResults": {
            "aws-sdk/clients/S3": null
          }
        },
        "npm:/aws-sdk/": {
          "importMap": {
            "imports": {
              "aws-sdk/": "npm:/aws-sdk/"
            }
          },
          "expectedResults": {
            "aws-sdk/clients/S3": "npm:/aws-sdk/clients/S3"
          }
        }
      }
    },
    "mapped_windows_file_specifier: a drive letter after a prefix is a path segment": {
      "importMapBaseURL": "file:///",
      "baseURL": "file:///main.ts",
      "importMap": {
        "imports": {
          "file:///": "http://localhost/"
        }
      },
      "expectedResults": {
        "file:///C:/folder/file.ts": "http://localhost/C:/folder/file.ts"
      }
    },
    "parse_with_no_double_encode: characters are percent-encoded once": {
      "importMapBaseURL": "file:///",
      "baseURL": "file:///mod.ts",
      "importMap": {
        "imports": {
          "./": "./"
        }
      },
      "expectedResults": {
        "./{name}.ts": "file:///%7Bname%7D.ts"
      }
    },
    "ext_expand_imports: jsr: and npm: entries gain subpath entries in imports and scopes": {
      "importMapBaseURL": "file:///deno.json",
      "expandImports": true,
      "importMap": {
        "imports": {
          "@std": "jsr:/@std",
          "@foo": "jsr:@foo",
          "express": "npm:express@4",
          "foo": "https://example.com/foo/bar"
        },
        "scopes": {
          "./folder/": {
            "@std": "jsr:/@std",
            "@foo": "jsr:@foo",
            "express": "npm:express@4",
            "foo": "https://example.com/foo/bar"
          }
        }
      },
      "expectedParsedImportMap": {
        "imports": {
          "@std": "jsr:/@std",
          "@std/": "jsr:/@std/",
          "@foo": "jsr:@foo",
          "@foo/": "jsr:/@foo/",
          "express": "npm:express@4",
          "express/": "npm:/express@4/",
          "foo": "https://example.com/foo/bar"
        },
        "scopes": {
          "file:///folder/": {
            "@std": "jsr:/@std",
            "@std/": "jsr:/@std/",
            "@foo": "jsr:@foo",
            "@foo/": "jsr:/@foo/",
            "express": "npm:express@4",
            "express/": "npm:/express@4/",
            "foo": "https://example.com/foo/bar"
          }
        }
      }
    },
    "test_expand_imports_with_trailing_slash: an existing prefix entry is kept": {
      "importMapBaseURL": "file:///deno.json",
      "expandImports": true,
      "importMap": {
        "imports": {
          "express": "npm:express@4",
          "express/": "npm:/express@4/foo/bar/"
        }
      },
      "expectedParsedImportMap": {
        "imports": {
          "express": "npm:express@4",
          "express/": "npm:/express@4/foo/bar/"
        },
        "scopes": {}
      }
    },
    "tests/test.ts: jsr: subpaths need expandImports": {
      "importMapBaseURL": "file:///a/import-map.json",
      "baseURL": "https://deno.land/x/oak/mod.ts",
      "importMap": {
        "imports": {
          "jsdom": "https://esm.sh/jsdom",
          "@std/assert": "jsr:@std/assert",
          "@std/testing": "jsr:@std/testing"
        }
      },
      "tests": {
        "without expansion": {
          "expectedResults": {
            "jsdom": "https://esm.sh/jsdom",
            "notfound": null,
            "@std/assert": "jsr:@std/assert",
            "@std/assert/test": null
          }
        },
        "with expansion": {
          "expandImports": true,
          "expectedResults": {
            "@std/testing/bdd": "jsr:/@std/testing/bdd",
            "@std/assert": "jsr:@std/assert"
          }
        }
      }
    },
    "iterate_applicable_entries: exact scopes win over prefix scopes, which fall back to imports": {
      "importMapBaseURL": "file:///deno.json",
      "importMap": {
        "imports": {
          "foo": "./main.ts"
        },
        "scopes": {
          "./folder/": {
            "bar": "./main.ts"
          },
          "./folder/file.ts": {
            "baz": "./other.ts"
          }
        }
      },
      "tests": {
        "prefix scope": {
          "baseURL": "file:///folder/main.ts",
          "expectedResults": {
            "foo": "file:///main.ts",
            "bar": "file:///main.ts",
            "baz": null
          }
        },
        "exact scope": {
          "baseURL": "file:///folder/file.ts",
          "expectedResults": {
            "foo": "file:///main.ts",
            "bar": "file:///main.ts",
            "baz": "file:///other.ts"
          }
        }
      }
    }
  }
}
