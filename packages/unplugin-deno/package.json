{
  "name": "unplugin-deno",
  "version": "0.0.0",
  "description": "Deno's module resolution (jsr:, npm:, https:, deno.json import maps and workspaces, deno.lock) for Vite, Rolldown, Rollup, esbuild, webpack, Rspack and Rsbuild",
  "keywords": [
    "bun",
    "deno",
    "deno-lock",
    "esbuild",
    "esbuild-plugin",
    "import-map",
    "jsr",
    "rolldown",
    "rolldown-plugin",
    "rollup",
    "rollup-plugin",
    "rsbuild",
    "rsbuild-plugin",
    "rspack",
    "rspack-plugin",
    "unplugin",
    "vite",
    "vite-plugin",
    "webpack",
    "webpack-plugin"
  ],
  "homepage": "https://github.com/brc-dd/unplugin-deno#readme",
  "bugs": "https://github.com/brc-dd/unplugin-deno/issues",
  "license": "MIT",
  "author": "Divyansh Singh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brc-dd/unplugin-deno.git",
    "directory": "packages/unplugin-deno"
  },
  "files": [
    "dist",
    "vendor",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./vite": "./dist/vite.js",
    "./rolldown": "./dist/rolldown.js",
    "./rollup": "./dist/rollup.js",
    "./esbuild": "./dist/esbuild.js",
    "./webpack": "./dist/webpack.js",
    "./rspack": "./dist/rspack.js",
    "./rsbuild": "./dist/rsbuild.js",
    "./bun": "./dist/bun.js",
    "./farm": "./dist/farm.js",
    "./register": "./dist/register.js",
    "./api": "./dist/api.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "test": "vitest run",
    "test:deno": "deno run -A npm:vitest run",
    "test:bun": "bun --bun x vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vendor:loader": "node scripts/vendor-loader.ts",
    "sync-version": "node scripts/sync-version.ts",
    "check-version": "node scripts/sync-version.ts --check",
    "jsr:dry-run": "deno publish --dry-run --allow-dirty",
    "jsr:publish": "node scripts/jsr-publish.ts",
    "publint": "publint",
    "attw": "attw --pack --profile esm-only"
  },
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "es-module-lexer": "^3.0.2",
    "jsonc-parser": "^3.3.1",
    "magic-string": "^1.4.2",
    "tinyglobby": "^0.2.17",
    "unplugin": "^3.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@rsbuild/core": "^2.2.9",
    "@rspack/core": "^2.2.7",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "esbuild-loader": "^4.5.0",
    "publint": "^0.3.24",
    "rolldown": "^1.2.11",
    "rollup": "^4.63.5",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite7": "npm:vite@^7",
    "vitest": "^5.0.2",
    "webpack": "^5.111.1"
  },
  "peerDependencies": {
    "@farmfe/core": "^1.7.0",
    "@rsbuild/core": "^2.0.0",
    "@rspack/core": "^2.0.0",
    "esbuild": ">=0.25.0",
    "rolldown": "^1.0.0",
    "rollup": "^4.40.0",
    "vite": "^7.0.0 || ^8.0.0",
    "webpack": "^5.108.0"
  },
  "peerDependenciesMeta": {
    "@farmfe/core": {
      "optional": true
    },
    "@rsbuild/core": {
      "optional": true
    },
    "@rspack/core": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
